# ================================================================
# IMKON TELEGRAM ADS MONITORING SYSTEM — CONFIGURATION (.env)
# ================================================================

# 1. Telegram Bot (BotFather orqali olingan token)
BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Bot Administratorlari (Telegram ID lar vergul bilan ajratilgan)
# Masalan: 123456789,987654321
ADMIN_IDS="123456789"

# 2. Telegram MTProto Developer API (https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH="0123456789abcdef0123456789abcdef"

# MTProto Sessiya (scripts/telegram_login.py orqali yaratiladi)
TELEGRAM_SESSION_STRING=""
TELEGRAM_SESSION_NAME="imkon_session"

# 3. PostgreSQL Database
# Docker Compose uchun: postgresql+asyncpg://postgres:postgres@postgres:5432/imkon_ads
# Lokal ishlatish uchun: postgresql+asyncpg://postgres:postgres@localhost:5432/imkon_ads
# SQLite test uchun: sqlite+aiosqlite:///./imkon_ads.db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/imkon_ads"

# Docker Postgres konfiguratsiyasi
POSTGRES_DB="imkon_ads"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secret_password"

# 4. Reklama qidiruv kalit so'zlari
DEFAULT_SEARCH_KEYWORD="@imkonhelpbot"
SEARCH_KEYWORDS="@imkonhelpbot,t.me/imkonhelpbot"

# 5. Monitoring intervallari va sozlamalari
# Yangi reklamalarni qidirish oralig'i (daqiqalarda)
SCAN_INTERVAL_MINUTES=60

# Yangi postlar (< 7 kun) statistikasini yangilash oralig'i (soatlarda)
RECENT_STATS_UPDATE_INTERVAL_HOURS=3

# Eski postlar (> 7 kun) statistikasini yangilash oralig'i (soatlarda)
OLD_STATS_UPDATE_INTERVAL_HOURS=24

# Avtomatik monitoring yoqilganligi (true / false)
ENABLE_AUTO_MONITORING=true

# Yangi reklama topilganda adminlarga tezkor bildirishnoma yuborish (true / false)
NOTIFY_ADMINS_ON_NEW_AD=true

# 6. Umumiy sozlamalar
TIMEZONE="Asia/Tashkent"
LOG_LEVEL="INFO"
